{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/backend/**"
    ]
  },
  "deploy": {
    "startCommand": "python scripts/run_worker.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 60,
    "overlapSeconds": 0
  }
}
