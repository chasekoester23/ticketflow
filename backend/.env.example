# The default extraction provider is Gemini 3.1 Pro (paid API).
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Optional fallback, enabled only when EXTRACTION_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-5-5

# Optional private benchmark only; not used by the production worker.
# OPENAI_API_KEY=
