# Never commit real scanned documents, human labels, or evaluation reports.
backend/evaluation_data/
backend/evaluation_results/
frontend/test-results/
frontend/playwright-report/

# Synthetic demonstration PDFs are locally generated, not source assets.
backend/demo_output/

# Backups hold real documents and records.
backend/backups/

# Generated by frontend/tests/e2e/flake-hunt.sh.
frontend/tests/.flake-hunt/

# Evaluation data. Real scans and labels never go in git; synthetic sets are
# regenerated by `python -m synthetic generate`. Only benchmark-mini is committed.
backend/eval_data/real/
backend/eval_data/synthetic/generated/
backend/eval_data/synthetic/*/pages/
backend/eval_data/synthetic/*.partial/
