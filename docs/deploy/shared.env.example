# Variables the API and the worker BOTH need. Placeholders only: never commit real values.
# On Railway, put these in the environment's Shared Variables and reference them from the
# "api" and "worker" services (${{shared.NAME}}), so the two can never drift apart.
# Both processes run the same startup checks (app/config.py configuration_problems).
# deploy-validation.yml checks this file, with api.env.example and worker.env.example,
# passes them in production mode.

TICKETFLOW_ENV=production

# On Railway: ${{Postgres.DATABASE_URL}} (the private URL). Its own database per environment.
DATABASE_URL=postgresql://<db-user>:<db-password>@<postgres-private-host>:5432/<db-name>

# Documents: one private Cloudflare R2 bucket per environment, through the S3 API.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_BUCKET=<ticketflow-production-documents>
# An R2 API token limited to this one bucket, with Object Read & Write only.
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_REGION=auto
S3_ADDRESSING_STYLE=path
# Optional folder inside the bucket. Leave empty when each environment has its own bucket.
S3_PREFIX=
# Optional app-level AES-256-GCM envelope encryption, on top of R2's own encryption at rest.
# 32 random bytes, base64 (python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())").
# Losing it loses every document written with it: keep it in a password manager as well.
# STORAGE_ENCRYPTION_KEY=<base64-32-bytes>

# Checked by both processes in production, so the worker needs them too.
SESSION_SECURE_COOKIE=true
# The exact https:// address people open. Checked against Origin on every change (CSRF).
CORS_ORIGINS=["https://<app.example.com>"]
# The API's private hostname (the frontend's proxy calls it), and Railway's healthcheck host.
TRUSTED_HOSTS=["api.railway.internal","healthcheck.railway.app"]
ENABLE_API_DOCS=false

# Reading tickets. Only the worker calls the provider, but the API shows whether it's set.
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>
