# The hosted FICTIONAL demo: use this file instead of shared.env.example, in the demo's own
# Railway project, with its own Postgres and its own bucket. Placeholders only.
# Startup refuses to run unless AI reading is off, no AI key is present, and the database
# and every bucket have "demo" in their names. A pilot refuses anything named "demo", so
# neither can be pointed at the other's data. deploy-validation.yml and
# tests/test_environments.py check this file passes once each <placeholder> is filled in.

APP_ENVIRONMENT=demo
TICKETFLOW_ENV=production

# A database created as quarvera_demo inside the demo's own Postgres service (Railway's
# template names its database "railway", which the demo refuses).
DATABASE_URL=postgresql://<db-user>:<db-password>@<postgres-private-host>:5432/quarvera_demo

STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
S3_BUCKET=quarvera-demo-documents
# An R2 API token limited to quarvera-demo-documents, Object Read & Write only.
S3_ACCESS_KEY_ID=<r2-access-key-id>
S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
S3_REGION=auto
S3_ADDRESSING_STYLE=path
S3_PREFIX=

SESSION_SECURE_COOKIE=true
CORS_ORIGINS=["https://<demo.example.com>"]
TRUSTED_HOSTS=["api.railway.internal","healthcheck.railway.app"]
ENABLE_API_DOCS=false

# Never reads with AI: demo tickets are entered by hand. Set no GEMINI_API_KEY,
# ANTHROPIC_API_KEY or OPENAI_API_KEY here: the hosted demo refuses to start with one.
AI_READING_ENABLED=false
