# Variables only the "api" service needs, on top of shared.env.example.
# Placeholders only. See docs/deploy/railway.md.

PORT=8080
# "::" listens on Railway's private network (IPv6) and on IPv4.
HOST=::
# The API has no public domain: only the frontend's proxy reaches it, on the private
# network. That proxy forwards one address, the one Railway's edge recorded. Trust
# forwarded headers only from the private network's range. fd00::/8 covers IPv6 unique
# local addresses; confirm the range Railway's private network uses before launch.
TRUSTED_PROXY_IPS=["fd00::/8"]
REQUIRE_HTTPS=true
APP_ORIGIN=https://app.example.com
# One process per service, so the per-process rate limits mean what they say.
WEB_CONCURRENCY=1
