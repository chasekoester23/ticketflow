# Variables for the "web" (frontend) service. Placeholders only. See docs/deploy/railway.md.

# Run time: where the Next server forwards /api/... on the private network.
API_INTERNAL_URL=http://api.railway.internal:8080
PORT=3000
HOSTNAME=0.0.0.0
# How many proxies in front of this one append to X-Forwarded-For. Railway's edge is one.
TRUSTED_PROXY_HOPS=1

# Build time: leave NEXT_PUBLIC_API_URL unset or empty. The Dockerfile builds with it
# empty, so the browser calls /api/... on this same origin and needs no CORS.
# NEXT_PUBLIC_API_URL=
