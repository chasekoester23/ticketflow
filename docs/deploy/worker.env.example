# Variables only the "worker" service needs, on top of shared.env.example.
# Placeholders only. See docs/deploy/railway.md.
#
# Run exactly ONE worker replica until worker leases replace the file lock
# (docs/deploy/audit.md). Its start command is: python scripts/run_worker.py

# Tickets read at once, each a separate request to the provider.
EXTRACTION_CONCURRENCY=4
